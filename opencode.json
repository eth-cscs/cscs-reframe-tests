{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "cscs": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CSCS Inference",
      "options": {
        "baseURL": "https://api.inference.cscs.ch/v1",
        "apiKey": "{env:CSCS_INFERENCE_API_KEY}"
      },
      "models": {
        "zai-org/GLM-5.3-Flash": {
          "name": "GLM-5.3-Flash",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 262144, "output": 16384 }
        },
        "zai-org/GLM-5.3": {
          "name": "GLM-5.3",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 262144, "output": 16384 }
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "allow"
    },
    "bash": "allow",
    "edit": "deny",
    "write": "deny",
    "webfetch": "allow"
  },
  "instructions": ["CONTRIBUTING.md","AGENTS.md"],
  "model": "cscs/zai-org/GLM-5.3-Flash",
  "small_model": "cscs/zai-org/GLM-5.3-Flash",
  "share": "disabled",
  "default_agent": "grumpy-reviewer"
}
